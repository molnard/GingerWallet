<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="using:WalletWasabi.Lang" xmlns:create="using:WalletWasabi.Fluent.AddWallet.ViewModels.Create"
             x:Class="WalletWasabi.Fluent.AddWallet.Views.Create.WalletBackupTypeView"
             x:DataType="create:WalletBackupTypeViewModel" x:CompileBindings="True">
  <ContentArea Title="{Binding Title}" EnableNext="True" EnableBack="{Binding EnableBack}" EnableCancel="{Binding EnableCancel}">
    <StackPanel Spacing="24" HorizontalAlignment="Center" MaxWidth="500">
      <TextBlock Text="{x:Static lang:Resources.MultiShareDescription}" TextWrapping="Wrap" />
      <ToggleSwitch Content="{x:Static lang:Resources.MultiShareBackup}" IsChecked="{Binding UseMultiShare}" />
      <TextBlock Text="{x:Static lang:Resources.SingleMnemonicBackup}" TextWrapping="Wrap" IsVisible="{Binding !UseMultiShare}" />
    </StackPanel>
  </ContentArea>
</UserControl>
